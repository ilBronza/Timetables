{
    "name": "ilbronza/timetables",
    "description": "Recurring schedules and availability queries for Laravel models",
    "license": "MIT",
    "authors": [
        {
            "name": "Davide Bronzini",
            "email": "davide_bronzini@hotmail.com",
            "homepage": "https://sistema.srl"
        }
    ],
    "homepage": "https://github.com/ilbronza/timetables",
    "keywords": [
        "Laravel",
        "timetables",
        "schedules",
        "availability"
    ],
    "require": {
        "php": ">=8.2",
        "php-64bit": ">=8.2",
        "illuminate/database": "^11.0 || ^12.0",
        "illuminate/support": "^11.0 || ^12.0",
        "illuminate/console": "^11.0 || ^12.0",
        "illuminate/http": "^11.0 || ^12.0",
        "illuminate/routing": "^11.0 || ^12.0",
        "illuminate/session": "^11.0 || ^12.0",
        "illuminate/validation": "^11.0 || ^12.0",
        "illuminate/view": "^11.0 || ^12.0",
        "illuminate/auth": "^11.0 || ^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0 || ^10.0",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "IlBronza\\Timetables\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IlBronza\\Timetables\\Tests\\": "tests/",
            "App\\": "tests/Fixtures/App/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "IlBronza\\Timetables\\TimetablesServiceProvider"
            ]
        }
    },
    "suggest": {
        "ilbronza/uikittemplate": "Default layout for the optional Timetables web editor",
        "ilbronza/crud": "Embed the optional editor in owner CRUD forms with a fetcher"
    }
}
